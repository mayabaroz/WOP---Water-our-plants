FROM python:3.12-slim

# Install Bluetooth libraries (bleak needs them at import time) + curl for healthcheck
RUN apt-get update && apt-get install -y \
    bluez libglib2.0-0 libdbus-1-3 curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies (source is bind-mounted, not baked in)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
