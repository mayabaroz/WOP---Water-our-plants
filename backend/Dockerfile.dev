# Development image for WOP backend — runtime only, source is bind-mounted.
FROM python:3.12-slim

# Bluetooth runtime libs so the `bleak` package imports on Linux
# (no actual BLE hardware is used in dev — the bridge is disabled).
RUN apt-get update && apt-get install -y --no-install-recommends \
    bluez libglib2.0-0 libdbus-1-3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install dependencies once; source is mounted at runtime so edits hot-reload.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

RUN mkdir -p /app/data/images

EXPOSE 3000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "3000", "--reload", "--reload-dir", "/app/app"]
