FROM python:3.12-slim

# Bluetooth system libraries required by bleak on Linux
RUN apt-get update && apt-get install -y --no-install-recommends \
    bluez libglib2.0-0 libdbus-1-3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Pre-install Python deps for faster startup (site-packages lives outside /app, survives bind mount)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

EXPOSE 3000
